{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Europe/London",
  "schedule": [
    "* 7-15 * * 1"
  ],
  "minimumReleaseAge": "7 days",
  "prCreation": "not-pending",
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 7-15 1 * *"
    ]
  },
  "packageRules": [
    {
      "description": "Group all GitHub Actions updates into one PR",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group non-major development dependency updates",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "dependency-groups"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "dev dependencies"
    }
  ]
}
